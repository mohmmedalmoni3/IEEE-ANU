NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/ieee_anu
DATABASE_SSL=false
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com

# Optional SMTP email notifications. If these are empty, emails are printed in the backend terminal.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-app-password
MAIL_FROM=IEEE ANU <notifications@example.com>
SUPPORT_EMAIL=support@example.com
SUPPORT_URL=https://wa.me/962000000000
